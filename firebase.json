{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {"source": "**", "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]},
      {"source": "/img/**", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
    ]
  }
}
